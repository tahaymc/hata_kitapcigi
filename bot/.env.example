# Bot HTTP server (kendi admin endpoint'leri)
PORT=3000
ADMIN_PORT=3002
NODE_ENV=development

# Ana siteye bağlantı (Supabase yerine API kullanılıyor)
SITE_API_URL=http://localhost:3001
# Bot'un WhatsApp yanıtlarındaki "detaylı çözüm" link'inde kullanılacak public URL.
# Boş bırakılırsa SITE_API_URL kullanılır. Production'da Vercel URL'i girin:
# SITE_PUBLIC_URL=https://siteniz.vercel.app
SITE_PUBLIC_URL=
# Bot, kendisini ana siteye tanıtmak ve admin endpoint'lerini korumak için bu token'ı kullanır.
# Ana site (.env) ile aynı olmalı: BOT_SHARED_TOKEN
BOT_SHARED_TOKEN=change-me-to-a-long-random-string

# Redis
# Seçenek A — Upstash veya bulut Redis (TLS):
#   REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379
# Seçenek B — Yerel Redis (Memurai/Docker):
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=true   # Manuel TLS açmak için

# WhatsApp oturum klasörü
SESSION_DIR=./auth_info_baileys

# Ayar/önbellek tazeleme aralığı (ms)
SETTINGS_REFRESH_MS=30000
HEARTBEAT_INTERVAL_MS=15000

# OCR saglayici secimi:
#   1) GOOGLE_VISION_API_KEY doluysa  -> Google Vision (en iyi, aylik ilk 1000 ucretsiz)
#   2) OCR_LOCAL_URL tanimliysa        -> yerel EasyOCR servisi (ucretsiz, bkz. ocr-service/)
#   3) hicbiri yoksa                   -> yerel Tesseract (en zayif)
# Hata durumunda her zaman Tesseract'a dusulur. OCR_PROVIDER ile zorlanabilir.
GOOGLE_VISION_API_KEY=
# Google Vision aylik ucretsiz kota (1000 birim/ay). Bot bu sayiya gelince
# Google'i hic cagirmadan otomatik olarak EasyOCR'a duser -> ucret yazmaz.
# Guvenli tampon icin biraz dusuk verilebilir (or. 950).
OCR_GOOGLE_MONTHLY_LIMIT=1000

# Yerel EasyOCR mikroservisi (ocr-service/). Kurulum/calistirma icin
# ocr-service/README.md. Google kotasi dolunca/Google basarisiz olunca otomatik
# devreye girer. Ornek:
# OCR_LOCAL_URL=http://127.0.0.1:8089
OCR_LOCAL_URL=
# OCR_PROVIDER=easyocr   # saglayiciyi elle sabitlemek icin (google|easyocr|tesseract)
